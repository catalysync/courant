{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courant",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": ".open-next/worker.js",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "courant-prod",
      "database_id": "7409f7a2-e0c5-4828-af35-b6f7961db37a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "USER_FILES", "bucket_name": "courant-assets" }
  ],
  "vars": {
    "CF_ACCOUNT_ID": "6d5166b8b31547608cbbba06affc288b",
    "NEXT_PUBLIC_APP_URL": "https://courant.protheolabs-ai-router.workers.dev"
  },
  "observability": { "enabled": true }
}